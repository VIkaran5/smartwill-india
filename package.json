{
  "name": "smartwill-india",
  "version": "1.0.0",
  "description": "SmartWill India — Online Will Creation Platform",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-dist.cjs",
    "build:win": "powershell -ExecutionPolicy Bypass -File scripts/build-dist.ps1",
    "cap:copy": "npx cap copy android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:debug": "npm run build && npx cap copy android && cd android && .\\gradlew.bat assembleDebug",
    "android:bundle": "npm run build && npx cap copy android && cd android && .\\gradlew.bat bundleRelease",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:fix": "npm audit fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/network": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "firebase-admin": "^13.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}
